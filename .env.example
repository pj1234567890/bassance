DB_URL=jdbc:postgresql://localhost:5432/edm_app
DB_USERNAME=your_postgres_role
DB_PASSWORD=your_postgres_password
# Use separate, randomly generated secrets (32+ characters). Never reuse these in production.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRY_MS=3600000
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_TOKEN=replace_with_a_different_random_secret
# Local HTTP only. Use true on Voroa and any HTTPS deployment.
COOKIE_SECURE=false
MAX_UPLOAD_BYTES=52428800
DB_POOL_SIZE=3
DB_POOL_MIN_IDLE=0
DB_POOL_IDLE_TIMEOUT_MS=30000
